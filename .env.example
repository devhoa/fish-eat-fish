PORT=3000
# Optional public Firebase web-app config, as a single-line JSON value.
# FIREBASE_WEB_CONFIG='{"apiKey":"...","authDomain":"...","projectId":"...","appId":"..."}'
# Use a private service-account file for local development.
# FIREBASE_SERVICE_ACCOUNT=./service-account.json
# Or set the complete service-account JSON as a secret environment variable on a cloud host.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
